{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElevenDrive",
  "version": "1.1.3",
  "identifier": "com.elevendrive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ElevenDrive",
        "decorations": false,
        "width": 1360,
        "height": 860,
        "minWidth": 1020,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:* ws://localhost:* https: wss:; frame-src 'self' https://meet.jit.si https://*.jit.si blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "licenseFile": "installer/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OUYwNDRENUQ4MkQzNTUKUldSVjA0SmRUUVNmRlBTa0N6SkFOL1lFT29YbStSMWt3Q25XVGlrYTRhc3dxVG1uYU9DTXJTeWEK",
      "endpoints": [
        "https://github.com/renemakoule/ElevenDrive/releases/latest/download/latest.json"
      ]
    }
  }
}